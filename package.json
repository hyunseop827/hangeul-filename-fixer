{
  "name": "hangeul-filename-fixer",
  "version": "1.1.0",
  "private": true,
  "description": "Hangeul Filename Fixer / 한글 파일명 정리기",
  "productName": "Hangeul Filename Fixer",
  "author": "Hyunseop Kim",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:hyunseop827/hangeul-filename-fixer",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:electron": "npm run build:main && node scripts/dev.mjs",
    "build:main": "rm -rf dist-electron && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "tsc --noEmit -p tsconfig.json && npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test \".test-dist/tests/*.test.js\""
  },
  "keywords": [
    "hangeul",
    "filename",
    "electron",
    "nfc"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.11.10",
    "electron-builder": "^26.0.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "build": {
    "appId": "app.hangeul-filename-fixer.desktop",
    "asar": true,
    "electronLanguages": [
      "ko",
      "en"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/ko.lproj/InfoPlist.strings",
        "to": "ko.lproj/InfoPlist.strings"
      },
      {
        "from": "build/en.lproj/InfoPlist.strings",
        "to": "en.lproj/InfoPlist.strings"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "Hangeul Filename Fixer",
        "CFBundleName": "Hangeul Filename Fixer",
        "LSHasLocalizedDisplayName": true
      }
    },
    "dmg": {
      "artifactName": "hangeul-filename-fixer-${version}.${ext}",
      "title": "한글 파일명 정리기 ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file",
          "name": "한글 파일명 정리기.app"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}

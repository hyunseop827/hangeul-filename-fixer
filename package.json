{
  "name": "hangeul-filename-fixer",
  "version": "1.0.0",
  "description": "Hangeul Filename Fixer / 한글 파일명 정리기",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder --mac dmg",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "keywords": [
    "hangeul",
    "filename",
    "electron",
    "nfc"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.0.12",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "app.hangeul-filename-fixer.desktop",
    "productName": "Hangeul Filename Fixer",
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/ko.lproj/InfoPlist.strings",
        "to": "ko.lproj/InfoPlist.strings"
      },
      {
        "from": "build/en.lproj/InfoPlist.strings",
        "to": "en.lproj/InfoPlist.strings"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": "-",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDisplayName": "Hangeul Filename Fixer",
        "CFBundleName": "Hangeul Filename Fixer",
        "LSHasLocalizedDisplayName": true
      }
    },
    "dmg": {
      "artifactName": "hangeul-filename-fixer-${version}.${ext}",
      "title": "한글 파일명 정리기 ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file",
          "name": "한글 파일명 정리기.app"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
